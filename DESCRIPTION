Package: zctaCrosswalk
Type: Package
Title: Crosswalk Between 2020 Census ZIP Code Tabulation Areas (ZCTAs), States and Counties
Version: 2.0.1
Authors@R: c(person("Ari Lamstein", role = c("aut"), email = "arilamstein@gmail.com"), 
